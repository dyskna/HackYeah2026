{
  // Jeden Worker serwuje API i frontend (Workers Static Assets). Nie ma osobnego projektu Pages.
  // Jedno `wrangler deploy`. Ciasteczko sesji jest na tej samej domenie co strona.
  // Wdrożenie: `npm run deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winda",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  // Limit prób aktywacji i logowania administratora per IP: 20 na minutę.
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BUILDING", "class_name": "BuildingDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BuildingDO"] }]
}
